# Database (Docker Compose service name)
DATABASE_URL=[DATABASE_URL_REDACTED]

# Auth
SECRET_KEY=dev-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
SECURE_COOKIES=false

# Anthropic (mock mode — no API key needed)
ANTHROPIC_API_KEY=
AI_MOCK_MODE=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security
SECURE_HEADERS=false

# Server
PORT=8000

# Rate limits (generous for dev)
RATE_LIMIT_CSV_UPLOADS_PER_DAY=100
RATE_LIMIT_SEARCH_RUNS_PER_DAY=500

# Redis / Celery (Docker Compose service name)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CSV_ASYNC_PROCESSING=true

# Email (blank = console-only dev mode)
RESEND_API_KEY=
FROM_EMAIL=WarmPath Dev <noreply@localhost>
FRONTEND_URL=http://localhost:5173

# Encryption (auto-generated for dev — DO NOT use in production)
# In production, ENCRYPTION_KEY is REQUIRED. The app fails closed if missing.
ENCRYPTION_KEY=ZmFrZS1lbmNyeXB0aW9uLWtleS1mb3ItZGV2LW9ubHk=
BLIND_INDEX_KEY=fake-blind-index-key-for-dev-only

# Security fail-open policy (both default false; production ignores them).
# Set to true ONLY for local development where you intentionally run without
# webhook secrets / encryption keys. The app logs loud warnings when active.
ALLOW_INSECURE_WEBHOOKS=false
ALLOW_PLAINTEXT_PII_FALLBACK=false

# Stripe (optional for local dev — set ALLOW_INSECURE_WEBHOOKS=true to skip)
STRIPE_WEBHOOK_SECRET=

# Agent run endpoint
AGENT_RUN_SECRET=dev-agent-secret

# Clerk (dev instance — get from Clerk dashboard)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_JWKS_URL=

# Telegram / Notion (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
NOTION_API_KEY=
NOTION_DAILY_BRIEFS_DB=
NOTION_DECISION_LOG_DB=
NOTION_FOUNDER_BRIEFS_DB=

# Vector search (Qdrant + OpenAI embeddings)
# Requires OPENAI_API_KEY when VECTOR_SEARCH_ENABLED=true
VECTOR_SEARCH_ENABLED=false
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=warmpath
OPENAI_API_KEY=
